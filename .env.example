# ==============================================================================
# TrackOps - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values to match your local setup:
#   cp .env.example .env
#
# DO NOT commit '.env' with sensitive credentials to version control.
# ==============================================================================

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://trackops:trackops@localhost:5432/trackops_prod

# Application Server Port
# In production, the unified Express server runs on this port and serves static assets.
PORT=5000
